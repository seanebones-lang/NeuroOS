# NeuroOS Environment Variables
# Copy to .env and fill in your values

# App
APP_NAME=neuro-os
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Browser origins allowed to call the API. Leave empty for CLI-only local use.
# Production requires one or more explicit HTTPS origins, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Redis-backed request limits. Login and registration share a 15-minute window.
REGISTRATION_RATE_LIMIT=5
LOGIN_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Authenticated protocol calls use a separate one-hour window per user.
PROTOCOL_RATE_LIMIT=20
PROTOCOL_RATE_LIMIT_WINDOW_SECONDS=3600

# Database (PostgreSQL with asyncpg)
DATABASE_URL=sqlite+aiosqlite:///neuro.db
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Production requires a unique, non-placeholder value with at least 32 characters.
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# AI Providers (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default Models
DEFAULT_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini
HEAVY_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small

# Scheduler
SCHEDULER_TIMEZONE=America/Chicago

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
